# Logging verbosity: 0=silent, 1=error, 2=warn, 3=info, 4=debug, 5=detail (default: 3)
VERBOSITY=3

NETWORK=mainnet
NODE_NO=1
RPC_PORT=8645
# WS_PORT=9645
# PORT=38645
# SYNCMODE=full
# GCMODE=archive
# DATA_DIR=/home/me/xdc_chain/mainnet_1
# SET_HEAD=95910000

# XDC_SRC=/home/me/XDPoSChain

# SNAPSHOT_FILE=snapshot/xinfin_full.tar
# SNAPSHOT_FILE=snapshot/xinfin_archive.tar

# Extra flags appended verbatim to the XDC command line.
# This node syncs the full chain from genesis in archive mode on a virtual disk.
# A full sync is throttled by leveldb, not by CPU: the stock 768 MiB database
# cache leaves a 384 MiB block cache in front of a chain database that already
# passes 460 GB, and each block then waits on a handful of 2.6 ms random reads.
# --cache is silently capped at a third of the host memory (the "Sanitizing
# cache to Go's GC limits" warning), so ask for that third and split it: 60% to
# the database, 20% to the trie caches, 5% to trie pruning.
# Do NOT add --fdlimit here: the allowance is taken from the process limit
# ("Max open files" in /proc/<pid>/limits) and halved, and asking for more than
# the process allows is only logged and ignored.
# Write the value without quotes: this file is sourced through a sed that wraps
# every value in single quotes, so quotes you add here end up in the flag names.
EXTRA_XDC_ARGS=--cache 20088 --cache-database 60 --cache-trie 20 --cache-gc 5
