# Logging verbosity: 0=silent, 1=error, 2=warn, 3=info, 4=debug, 5=detail (default: 3)
VERBOSITY=3

GAS_PRICE=1
LOG_DIR="logs"
NETWORK_ID=5151

# for master nodes
BASE_PORT=30000
BASE_RPC_PORT=8545
BASE_WS_RPC_PORT=9545

# for oberver nodes
OBSERVER_BASE_PORT=31000
OBSERVER_BASE_RPC_PORT=8645
OBSERVER_BASE_WS_RPC_PORT=9645

PRIVATE_KEY_0=<KEY0>
PRIVATE_KEY_1=<KEY1>
PRIVATE_KEY_2=<KEY2>

# gas2500x tests (see gas2500x-test.md; generate the raw keys below with
# the bootnode tool: `bootnode -genkey <file>`):
# PRIVATE_KEY_3 = pn3 observer node key (must NOT be a genesis signer)
# TXGEN_KEY_1   = raw sender key S1 (bulk queued transactions)
# TXGEN_KEY_2   = raw sender key S2 (queued transactions + replacement pair)
# TXGEN_KEY_3   = raw sender key S3 (executable floor probes)
# TXGEN_KEY_4   = raw sender key S4 (above-floor sweep survivor, T34)
# All submissions are signed locally with `cast send --private-key`.
# PRIVATE_KEY_3=<KEY3>
# TXGEN_KEY_1=<KEYS1>
# TXGEN_KEY_2=<KEYS2>
# TXGEN_KEY_3=<KEYS3>
# TXGEN_KEY_4=<KEYS4>

XDC="/home/liudan/XDPoSChain/build/bin/XDC"
XDC2="/home/liudan/XDPoSChain/build/bin/XDC2"
