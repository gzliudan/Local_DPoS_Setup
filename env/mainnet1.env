# Logging verbosity: 0=silent, 1=error, 2=warn, 3=info, 4=debug, 5=detail (default: 3)
VERBOSITY=3

NETWORK=mainnet
NODE_NO=1
RPC_PORT=8645
# WS_PORT=9645
# PORT=38645
# SYNCMODE=full
# GCMODE=archive
# DATA_DIR=/home/me/xdc_chain/mainnet_1
# SET_HEAD=95910000

# XDC_SRC=/home/me/XDPoSChain

# SNAPSHOT_FILE=snapshot/xinfin_full.tar
# SNAPSHOT_FILE=snapshot/xinfin_archive.tar

# Extra flags appended verbatim to the XDC command line.
# This node syncs the full chain from genesis in archive mode on a virtual disk.
# The stock 768 MiB database cache leaves a 384 MiB leveldb block cache in front
# of a chain database that already passes 460 GB, which is what throttles the
# import: every block waits on a handful of 2.6 ms random reads.  Give the
# database a block cache large enough to hold the working set instead.
# Do NOT add --fdlimit here: the file descriptor allowance is taken from the
# process limit (see "Max open files" in /proc/<pid>/limits) and halved, and
# asking for more than the process allows is only logged and ignored.
# Write the value without quotes: this file is sourced through a sed that wraps
# every value in single quotes, so quotes you add here end up in the flag names.
EXTRA_XDC_ARGS=--cache 49152 --cache-database 25 --cache-trie 12 --cache-gc 4
